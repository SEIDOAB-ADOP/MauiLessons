<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiLessons.Views.Lesson06.ActivityProgressPage2"
             Title="ActivityIndicator and ProgressBar Demos">
    <ScrollView>
        <VerticalStackLayout>
            <Label Text="{Binding Message}"
                   FontSize="25"
                   HorizontalOptions="CenterAndExpand"
                   Margin="0,20,0,20"/>
            <StackLayout HeightRequest="200">
                <ProgressBar x:Name="defaultProgressBar"
                         WidthRequest="500"
                         VerticalOptions="CenterAndExpand"
                         HorizontalOptions="Fill" Scale="2"/>
                <ProgressBar x:Name="styledProgressBar"
                         WidthRequest="500"
                         ProgressColor="Orange"
                         VerticalOptions="CenterAndExpand"
                         HorizontalOptions="Fill" Scale="2"/>
                <Button Text="Click to Calculate"
                        VerticalOptions="CenterAndExpand"
                        HorizontalOptions="CenterAndExpand"
                        Clicked="OnButtonClicked" />
            </StackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>